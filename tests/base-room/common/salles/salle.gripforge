    "scripts": [
      {
        "id": "salle_pilier",
        "on": "scene:salle_room",
        "rules": [
          {
            "when": {
              "var": "pilier",
              "op": "==",
              "value": false
            },
            "then": [
              {
                "set_solid": false,
                "on": "pilier"
              }
            ]
          },
          {
            "when": {
              "var": "pilier",
              "op": "==",
              "value": true
            },
            "then": [
              {
                "set_solid": true,
                "on": "pilier"
              }
            ]
          }
        ]
      },
      {
        "id": "salle_places",
        "on": "scene:salle_room",
        "rules": [
          {
            "when": {
              "var": "place",
              "op": "==",
              "value": "depart"
            },
            "then": [
              {
                "teleport": {
                  "entity": {
                    "tag": "player"
                  },
                  "to": [
                    0,
                    0,
                    0
                  ]
                }
              },
              {
                "set_var": {
                  "path": "place",
                  "value": ""
                }
              }
            ]
          },
          {
            "when": {
              "var": "place",
              "op": "==",
              "value": "escalier"
            },
            "then": [
              {
                "teleport": {
                  "entity": {
                    "tag": "player"
                  },
                  "to": [
                    -0.5,
                    0,
                    -7
                  ]
                }
              },
              {
                "set_var": {
                  "path": "place",
                  "value": ""
                }
              }
            ]
          },
          {
            "when": {
              "var": "place",
              "op": "==",
              "value": "mur"
            },
            "then": [
              {
                "teleport": {
                  "entity": {
                    "tag": "player"
                  },
                  "to": [
                    0,
                    0,
                    10.6
                  ]
                }
              },
              {
                "set_var": {
                  "path": "place",
                  "value": ""
                }
              }
            ]
          }
        ]
      }
    ],
    "stations": [
      {
        "id": "salle-saut",
        "title": "Sauter",
        "todo": "Rien : le banc appuie sur l'action « sauter » (premier poste : le joueur est encore à l'entrée, sous la zone haute).",
        "see": "La capsule saute et sa tête traverse la zone à 2,2 m au-dessus d'elle, puis retombe.",
        "proves": "Le saut de core.locomotion passe par core.physics ; la zone haute de game.engine voit le joueur.",
        "needs": {
          "kits": [
            "core.control",
            "core.locomotion",
            "core.physics",
            "world.zones"
          ]
        },
        "setup": [
          {
            "set_var": {
              "path": "salle.saut",
              "value": false
            }
          }
        ],
        "drive": [
          {
            "action": {
              "name": "jump",
              "press": true
            },
            "for": 0.1
          },
          {
            "until": {
              "read": "vars.salle.saut",
              "eq": true
            },
            "timeout": 3
          }
        ],
        "judge": [
          {
            "read": "vars.salle.saut",
            "at": "end",
            "eq": true
          }
        ],
        "timeout": 8
      },
      {
        "id": "salle-marche",
        "title": "Marcher",
        "todo": "Rien : le banc pousse le joueur droit devant (intention « avancer » de core.control).",
        "see": "La capsule avance de 4 m vers la bande d'arrivée, posée sur le sol, sans traverser de mur.",
        "proves": "Le joueur de la salle (instance game.engine) est déplacé par core.locomotion sur le sol de core.physics, et la zone de game.engine le voit entrer.",
        "needs": {
          "kits": [
            "core.control",
            "core.locomotion",
            "core.physics",
            "world.zones"
          ],
          "entities": []
        },
        "setup": [
          {
            "set_var": {
              "path": "salle.arrivee",
              "value": false
            }
          }
        ],
        "drive": [
          {
            "intent": {
              "move": [
                0,
                0,
                1
              ]
            },
            "for": 0.2
          },
          {
            "until": {
              "read": "vars.salle.arrivee",
              "eq": true
            },
            "timeout": 6
          }
        ],
        "judge": [
          {
            "read": "vars.salle.arrivee",
            "at": "end",
            "eq": true
          }
        ],
        "timeout": 12
      },
      {
        "id": "salle-pilier-cache",
        "title": "Pilier caché par sa variable",
        "todo": "Rien : le banc met la variable « pilier » de la salle à faux.",
        "see": "Le pilier rouge disparaît au rendu (WebGPU comme WebGL2) et on peut passer à sa place.",
        "proves": "Un visible lié par $var suit la variable au rendu (état dérivé + reflet de game.engine) ; la règle de la salle retire sa collision.",
        "needs": {
          "kits": [
            "game.engine"
          ]
        },
        "setup": [
          {
            "set_var": {
              "path": "salle.pilier",
              "value": false
            }
          }
        ],
        "drive": [
          {
            "wait": 0.5
          }
        ],
        "judge": [
          {
            "read": "vars.salle.pilier",
            "at": "end",
            "eq": false
          }
        ]
      },
      {
        "id": "salle-pilier-revient",
        "title": "Pilier revenu",
        "todo": "Rien : le banc remet la variable « pilier » à vrai.",
        "see": "Le pilier rouge réapparaît au rendu, à la même place, et bloque de nouveau.",
        "proves": "Un set_var en jeu fait réapparaître le pilier au rendu, sans recopie par tick.",
        "needs": {
          "kits": [
            "game.engine"
          ]
        },
        "setup": [
          {
            "set_var": {
              "path": "salle.pilier",
              "value": true
            }
          }
        ],
        "drive": [
          {
            "wait": 0.5
          }
        ],
        "judge": [
          {
            "read": "vars.salle.pilier",
            "at": "end",
            "eq": true
          }
        ]
      },
      {
        "id": "salle-angle",
        "title": "Objet en L (deux nœuds de collision)",
        "todo": "Rien : la bille jaune tombe sur le bras court de l'objet violet en L.",
        "see": "La bille jaune reste posée sur le bras court de l'objet violet en L (à 1 m de haut) ; la zone sous le bras ne la voit jamais.",
        "proves": "Deux nœuds collision enfants font un corps composé qui suit le dessin et remplacent la boîte automatique du parent (#1864).",
        "needs": {
          "kits": [
            "core.physics",
            "game.engine",
            "world.zones"
          ]
        },
        "drive": [
          {
            "wait": 1.5
          }
        ],
        "judge": [
          {
            "read": "vars.salle.angle_posee",
            "at": "end",
            "eq": true
          },
          {
            "read": "vars.salle.angle_tombee",
            "at": "end",
            "eq": false
          }
        ],
        "timeout": 6
      }
    ]
  },
  "meta": {
    "about": "La salle du banc de démo (fiche banc § 4, lot S) en sous-fichier .gripforge : sol, murs, marches, pilier (variable « pilier »), soleil de core.light, joueur banc_joueur posé à l'entrée (son archétype et ses kits viennent de banc.gripforge, inclus), zones d'arrivée et de saut, et les postes de base en données (data.stations, joués par debug.inspector.bench). Une démo l'inclut par includes avec as: salle (les postes lisent salle.<variable>) et la règle par ses variables. Tirée de room.json et player.json (mêmes cotes) ; la pente reste à faire (game.engine ne garde que le lacet d'un solide)."
  }
}
