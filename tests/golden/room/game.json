   "scripts": [
    {
     "id": "gfscene_menu",
     "on": "scene:menu",
     "rules": [
      {
       "when": {
        "event": "room.play"
       },
       "then": [
        {
         "load_scene": {
          "scene": "level"
         }
        }
       ]
      }
     ]
    },
    {
     "id": "gfscene_level",
     "on": "scene:level",
     "rules": [
      {
       "when": {
        "event": "world.zones.entered",
        "match": {
         "zone": "hall_door"
        }
       },
       "then": [
        {
         "emit": {
          "topic": "room.door_reached"
         }
        },
        {
         "inc_var": {
          "path": "room.doors",
          "delta": 1
         }
        }
       ]
      },
      {
       "when": {
        "event": "room.walk_in"
       },
       "then": [
        {
         "teleport": {
          "entity": {
           "tag": "visitor"
          },
          "to": [
           0,
           0.8,
           -8
          ]
         }
        }
       ]
      },
      {
       "when": {
        "interact": "hall_door"
       },
       "then": [
        {
         "set_state": {
          "door": "open"
         },
         "on": "hall_door"
        }
       ],
       "if": [
        {
         "state": {
          "door": "closed"
         },
         "on": "hall_door"
        }
       ]
      }
     ]
    }
