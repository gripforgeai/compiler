{
  "schema": "gripforge.gameproject/1",
  "id": "includes_salle",
  "name": "salle incluse (preuve du format)",
  "preset": null,
  "installed": [
    {
      "id": "game.engine",
      "version": "1.23.0",
      "enabled": true,
      "config": {
        "startScene": "room",
        "placement": "baked",
        "debug": false,
        "flow": {
          "title": "off"
        },
        "sceneFlow": {
          "loading": "none",
          "minLoadingMs": 0,
          "unload": "release",
          "transition": "replace"
        }
      }
    },
    {
      "id": "core.physics",
      "version": "1.6.0",
      "enabled": true,
      "config": {}
    },
    {
      "id": "core.input",
      "version": "2.0.0",
      "enabled": true,
      "config": {
        "actions": [
          {
            "name": "move",
            "kind": "vector",
            "bindings": [
              {
                "up": "KeyW",
                "down": "KeyS",
                "left": "KeyA",
                "right": "KeyD"
              },
              "StickLeft"
            ]
          },
          {
            "name": "jump",
            "bindings": [
              "Space"
            ]
          },
          {
            "name": "run",
            "bindings": [
              "ShiftLeft"
            ]
          },
          {
            "name": "look",
            "kind": "vector",
            "bindings": [
              "MouseMotion"
            ]
          },
          {
            "name": "interact",
            "bindings": [
              "KeyE"
            ]
          }
        ],
        "pointer": {
          "lock": "click"
        }
      }
    },
    {
      "id": "core.camera",
      "version": "1.0.0",
      "enabled": true,
      "config": {}
    },
    {
      "id": "core.control",
      "version": "0.2.0",
      "enabled": true,
      "config": {}
    },
    {
      "id": "core.locomotion",
      "version": "0.2.0",
      "enabled": true,
      "config": {}
    },
    {
      "id": "core.animation",
      "version": "0.4.0",
      "enabled": true,
      "config": {}
    },
    {
      "id": "locomotion.third_person",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "keys": {
          "move_x": {
            "kind": "axis",
            "bindings": [
              {
                "neg": "KeyA",
                "pos": "KeyD"
              },
              {
                "neg": "ArrowLeft",
                "pos": "ArrowRight"
              }
            ]
          },
          "move_y": {
            "kind": "axis",
            "bindings": [
              {
                "neg": "KeyS",
                "pos": "KeyW"
              },
              {
                "neg": "ArrowDown",
                "pos": "ArrowUp"
              }
            ]
          },
          "move_pad": {
            "kind": "vector",
            "bindings": [
              "StickLeft"
            ],
            "invertY": true
          },
          "sprint": {
            "kind": "button",
            "bindings": [
              "ShiftLeft",
              "ShiftRight",
              "Pad10"
            ]
          },
          "jump": {
            "kind": "button",
            "bindings": [
              "Space",
              "Pad0"
            ]
          },
          "crouch": {
            "kind": "button",
            "bindings": [
              "KeyC",
              "ControlLeft",
              "Pad1"
            ]
          },
          "orbit": {
            "kind": "button",
            "bindings": [
              "Mouse0"
            ]
          },
          "steer": {
            "kind": "button",
            "bindings": [
              "Mouse2"
            ]
          }
        }
      }
    },
    {
      "id": "debug.inspector",
      "version": "1.8.0",
      "enabled": true,
      "config": {
        "toggleKey": "F9",
        "edit": {
          "toggleKey": "F2",
          "gizmo": {
            "keys": {
              "move": "KeyW",
              "rotate": "KeyE",
              "space": "KeyT",
              "turnCw": "KeyR",
              "turnCcw": "ShiftLeft+KeyR",
              "undo": "ControlLeft+KeyZ",
              "turnAxis": "Wheel"
            }
          }
        },
        "snapshotWatchTicks": 1200,
        "replay": {
          "ignore": [
            "debug.",
            "core.camera.rigs",
            "kits.core.camera",
            "core.camera.watched",
            "core.light.lights"
          ]
        }
      }
    },
    {
      "id": "asset.preload",
      "version": "2.1.0",
      "enabled": true,
      "config": {
        "cells": {
          "trigger": "auto",
          "everyTicks": 5,
          "keepS": 2,
          "preload": 1.5,
          "maxLoaded": 4,
          "mode": "background"
        }
      }
    },
    {
      "id": "core.light",
      "version": "1.0.0",
      "enabled": true,
      "config": {}
    },
    {
      "id": "core.webui",
      "version": "1.10.0",
      "enabled": true,
      "config": {}
    }
  ],
  "bindings": {},
  "variables": {
    "pilier": true,
    "annexe": true
  },
