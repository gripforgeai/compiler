# The acceptance of the game's code declared in `sources` (gripforgeai/gripforge#420) on the template fps-shooter:
# written by run.sh from this file (@MK@: the checkout of the kits repository; its [patch.crates-io] appended), never a
# member of the compiler's workspace.
[package]
name = "gf-accept-fps-shooter"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
# The kits in a Bevy game, headless: the gateway of the kits repository, as a player of the game loads them.
bevy = { version = "0.20", default-features = false, features = ["std", "multi_threaded", "3d_bevy_render", "scene"] }
gfkits-bevy-native = { path = "@MK@/gateways/gfkits-bevy-native/native", features = ["shapes"] }
serde_json = "1"
# The folder of kit libraries a gateway loads (kit-modules-native.json), as the templates' check writes it.
gripforge-kit-common = { path = "@MK@/core/kit-common", features = ["tests"] }

# The generated crates under game/ are workspaces of their own.
[workspace]
exclude = ["game"]
